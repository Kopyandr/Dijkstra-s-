        selected_cities = cities  # all 

    city_names = list(selected_cities.keys())
    results = {}  # Dictionary for resutls 

    for city1, city2 in combinations(city_names, 2):# Generate all combinations of two cities
        node1 = selected_cities[city1]
        node2 = selected_cities[city2]

        distances, predecessors = Dijkstra(G_dict, node1, node2, method)  # Call Dijkstra algorithm
        route = reconstruct_path(predecessors, node1, node2)        # Reconstruct the path

        # Use a string key instead of a tuple for JSON compatibility
        results[f"({city1}, {city2})"] = {"distance": distances[node2], "route": route}
    
        print(f"{city1} to {city2}: distance = {distances[node2]}, route = {route}")
        
    with open("all_shortest_paths.json", "w", encoding="utf-8") as f:
        json.dump(results, f, ensure_ascii=False, indent=2)
    
    return results

def kruskas(G, method='distance'):
    
    edges = []  # list to store edges as (weight, node, neighbour)
    
    for node, neighbors in G.items():
        for neighbour, properties in neighbors.items():
            if method == 'travel time':
                weight = (properties['length'] / 1000) / properties['speed_kph']
            else:
                weight = properties['length']
            if node < neighbour:
                edges.append((weight, node, neighbour))
    
    edges.sort(key=lambda x: x[0])
    
    parent = {node: node for node in G}
    rank = {node: 0 for node in G}
    
    def find(x):
        if parent[x] != x:
            parent[x] = find(parent[x])
        return parent[x]
    
    def union(x, y):
        root_x = find(x)
        root_y = find(y)
        if root_x == root_y:
            return False
        if rank[root_x] < rank[root_y]:
            parent[root_x] = root_y
        elif rank[root_x] > rank[root_y]:
            parent[root_y] = root_x
        else:
            parent[root_y] = root_x
            rank[root_x] += 1
        return True
    
    mst = []
    for weight, u, v in edges:
        if union(u, v):
            mst.append((u, v, weight))
            
    mst_dict = [{"u": u, "v": v, "weight": weight} for (u, v, weight) in mst]
    with open("minimum_spanning_tree.json", "w", encoding="utf-8") as f:
        json.dump(mst_dict, f, ensure_ascii=False, indent=2)

    print("MST saved to minimum_spanning_tree.json")
    return mst

