def Dijkstra (G,start,end,method='distance'): #Dijstra function 
    distances = {node: float('inf') for node in G} # Distances set to inf 
    distances[start] = 0 # The start node distance=0 
    predecessors = {node: None for node in G} # set initial perent nodes to None 
    queue = [(0, start)] # Priority queue: chosing the closest node (dist optimazation)

    while queue: 
        current_distance, current_node= heapq.heappop(queue) #returns the distance, and the node while clearing the que  
        # current_distance=0,current_node=start
        if current_node==end: 
            break
        if current_distance > distances[current_node]: # is the current distance (0) > than the distances[current_node]->skip   
            continue  
        
        for neighbor,properties in G[current_node].items(): #returns 1st (neigbor=2, weight=8)

            if method=='travel time': #chosing the weight computation method 
                new_distance=current_distance + (properties['length']/1000)/(properties['speed_kph']) # lenght(km)/velosityy(kph)
            
            else:
                new_distance=current_distance+properties['length'] #plain distance 
                
            if new_distance < distances[neighbor]: 
                distances[neighbor]=new_distance
                predecessors[neighbor]=current_node 
                heapq.heappush(queue,(new_distance,neighbor)) # que now = [(8,2)] 
    return(distances, predecessors) 
 
 
def reconstruct_path (predecessors, start,end): # the path reconstruction 
    path=[] 
    current=end # starting from the end 
    while current is not None: 
        path.append(current) 
        if current==start:
            break
        current=predecessors[current] # set the current to the parent(predecesor) of the curent
    path.reverse() # 
    
    if path[0]!= start: 
        print('incorect path')
        return[]
    
    return path


def bellman_ford (G,start, method='distance'): 
    num_nodes = len(G)
    distances = {node: float('inf') for node in G} #set distances of nodes to inf 
    distances[start] = 0 # The start node distance=0 
    predecessors = {node: None for node in G} # set initial perent nodes to None 
    
    for i in range(num_nodes-1): # n - 1 iterations  
        for current in G: #for eache node in the graph 
            for neighbor, properties in G[current].items(): 
                
                if method=='travel time': #chosing the weight computation method 
                    weight= (properties['length']/1000)/properties['speed_kph'] # lenght(km)/velosityy(kph)
                else: 
                    weight=properties['length']
                
                if distances[current]+weight<distances[neighbor]:
                    distances[neighbor]=distances[current]+weight
                    predecessors[neighbor]=current
             
    # Check for as negative cycle: 
    for current in G: #
        for neighbor, properties in G[current].items():
            if method == 'travel time':
                weight = (properties['length'] / 1000) / properties['speed_kph']
            else:
                weight = properties['length']
            if distances[current] + weight < distances[neighbor]: # can the edge be relaxed ? 
                raise ValueError("The graph contains a negative weight cycle") # no bueno 

    return distances, predecessors


def calculate_combinations(G, limit=None, method="distance"):
    if limit is not None:
